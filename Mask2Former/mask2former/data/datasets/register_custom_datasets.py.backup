import os
from detectron2.data import DatasetCatalog, MetadataCatalog

CITYSCAPES_CLASSES = [
    "road", "sidewalk", "building", "wall", "fence", "pole",
    "traffic light", "traffic sign", "vegetation", "terrain",
    "sky", "person", "rider", "car", "truck", "bus",
    "train", "motorcycle", "bicycle"
]

CITYSCAPES_COLORS = [
    [128, 64, 128], [244, 35, 232], [70, 70, 70], [102, 102, 156],
    [190, 153, 153], [153, 153, 153], [250, 170, 30], [220, 220, 0],
    [107, 142, 35], [152, 251, 152], [70, 130, 180], [220, 20, 60],
    [255, 0, 0], [0, 0, 142], [0, 0, 70], [0, 60, 100],
    [0, 80, 100], [0, 0, 230], [119, 11, 32]
]


def _load_bdd100k_sem_seg(img_dir, label_dir):
    """Load BDD100K semantic segmentation"""
    dataset_dicts = []
    
    if not os.path.exists(img_dir) or not os.path.exists(label_dir):
        return dataset_dicts
    
    image_files = sorted([f for f in os.listdir(img_dir) if f.endswith('.jpg')])
    
    for idx, image_file in enumerate(image_files):
        image_path = os.path.join(img_dir, image_file)
        # BDD100K: image.jpg -> image_train_id.png or just image.png
        label_file = image_file.replace('.jpg', '.png')
        label_path = os.path.join(label_dir, label_file)
        
        # Also try with _train_id suffix
        if not os.path.exists(label_path):
            label_file = image_file.replace('.jpg', '_train_id.png')
            label_path = os.path.join(label_dir, label_file)
        
        if not os.path.exists(label_path):
            continue
        
        record = {
            "file_name": image_path,
            "sem_seg_file_name": label_path,
            "height": 720,
            "width": 1280,
            "image_id": idx,
        }
        dataset_dicts.append(record)
    
    return dataset_dicts


def _load_gta5_sem_seg(img_dir, label_dir):
    """Load GTA5 semantic segmentation"""
    dataset_dicts = []
    
    if not os.path.exists(img_dir) or not os.path.exists(label_dir):
        return dataset_dicts
    
    image_files = sorted([f for f in os.listdir(img_dir) if f.endswith('.png')])
    
    for idx, image_file in enumerate(image_files):
        image_path = os.path.join(img_dir, image_file)
        label_path = os.path.join(label_dir, image_file)
        
        if not os.path.exists(label_path):
            continue
        
        record = {
            "file_name": image_path,
            "sem_seg_file_name": label_path,
            "height": 1052,
            "width": 1914,
            "image_id": idx,
        }
        dataset_dicts.append(record)
    
    return dataset_dicts


def register_bdd100k():
    """Register BDD100K"""
    root = os.path.join(os.getenv("DETECTRON2_DATASETS", "datasets"), "bdd100k")
    if not os.path.exists(root):
        return
    
    print(f"Registering BDD100K from: {root}")
    
    for split in ["train", "val"]:
        img_dir = os.path.join(root, f"images/{split}")
        label_dir = os.path.join(root, f"labels/{split}")
        
        name = f"bdd100k_sem_seg_{split}"
        
        # Use a factory function to avoid closure issues
        def make_loader(img_path, label_path):
            return lambda: _load_bdd100k_sem_seg(img_path, label_path)
        
        DatasetCatalog.register(name, make_loader(img_dir, label_dir))
        MetadataCatalog.get(name).set(
            stuff_classes=CITYSCAPES_CLASSES,
            stuff_colors=CITYSCAPES_COLORS,
            evaluator_type="sem_seg",
            ignore_label=255,
        )
        print(f"  ✓ Registered {name}")


def register_gta5():
    """Register GTA5"""
    root = os.path.join(os.getenv("DETECTRON2_DATASETS", "datasets"), "gta5")
    if not os.path.exists(root):
        return
    
    print(f"Registering GTA5 from: {root}")
    
    img_dir = os.path.join(root, "images")
    label_dir = os.path.join(root, "labels")
    
    name = "gta5_sem_seg_train"
    
    def make_loader(img_path, label_path):
        return lambda: _load_gta5_sem_seg(img_path, label_path)
    
    DatasetCatalog.register(name, make_loader(img_dir, label_dir))
    MetadataCatalog.get(name).set(
        stuff_classes=CITYSCAPES_CLASSES,
        stuff_colors=CITYSCAPES_COLORS,
        evaluator_type="sem_seg",
        ignore_label=255,
    )
    print(f"  ✓ Registered {name}")


# Auto-register
print("\n=== Registering custom datasets ===")
register_bdd100k()
register_gta5()
print("=== Done ===\n")
